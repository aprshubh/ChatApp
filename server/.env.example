# Application
APP_NAME=ChatApp
ENV=development
APP_URL=http://localhost:8080

# Server Configuration
PORT=8080
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# CORS Configuration (comma-separated origins or *)
CORS_ALLOWED_ORIGINS=*

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/chatapp?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m

# Email provider: console (development only), resend, or smtp
EMAIL_PROVIDER=console
EMAIL_FROM=onboarding@resend.dev

# Resend (used when EMAIL_PROVIDER=resend)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=

# SMTP (used when EMAIL_PROVIDER=smtp; TLS/STARTTLS is required)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# S3-Compatible Object Storage (LocalStack S3 / AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=localstack
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_BUCKET_NAME=chatapp-media-encrypted
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
STORAGE_USE_PATH_STYLE=true
STORAGE_PRESIGNED_URL_EXPIRES=15m
